{
  "name": "gilmok",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "lint": "eslint . && uv run --frozen ruff check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.visibility-worker.json --noEmit",
    "test": "vitest run && uv run --frozen pytest tests/ingest",
    "test:db": "uv run --frozen pytest tests/integration",
    "ingest:smoke": "uv run --frozen python -m ingest.smoke",
    "score:reference:build": "tsc -p tsconfig.scoring-batch.json",
    "visibility:build": "tsc -p tsconfig.scoring-batch.json && tsc -p tsconfig.visibility-worker.json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
