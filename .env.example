# Local Supabase: start with `supabase start`. Never commit actual remote credentials.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Set from local Supabase status when client/API tests need it.
SUPABASE_ANON_KEY=

# All four blank => local filesystem. Partial R2 configuration is an error.
INGEST_LOCAL_ROOT=.local/ingest
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Not needed for PR 1 local tests. Service approvals are separate from keys.
DATA_GO_KR_SERVICE_KEY=
SEOUL_OPEN_DATA_API_KEY=
KAKAO_REST_API_KEY=
VWORLD_API_KEY=
NEIS_API_KEY=

# Only needed when a remote project is ready.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
