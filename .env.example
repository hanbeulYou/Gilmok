# Python batch: direct Postgres connection, not a Supabase API key.
# Local Supabase: start with `supabase start`. Never commit actual remote credentials.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Browser / user-session API client (sb_publishable_...). RLS applies.
# Vercel Marketplace injects these exact names. Only these two reach the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin API client (sb_secret_...). Bypasses RLS.
# Optional until admin API calls are implemented; never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# All four blank => local filesystem. Partial R2 configuration is an error.
INGEST_LOCAL_ROOT=.local/ingest
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Not needed for PR 1 local tests. Service approvals are separate from keys.
DATA_GO_KR_SERVICE_KEY=
# PR 6: R-ONE credentials belong only in .env, never in this example.
RONE_API_KEY=
RONE_API_URL=https://www.reb.or.kr/r-one/openapi/SttsApiTblData.do
COMMERCIAL_TRADES_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcNrgTrade/getRTMSDataSvcNrgTrade
VWORLD_WFS_URL=https://api.vworld.kr/req/wfs
SEOUL_OPEN_DATA_API_KEY=
# Seoul OA-12252/OA-12913 and their coordinate APIs; key is appended only in /ingest.
SEOUL_TRANSIT_API_URL=http://openapi.seoul.go.kr:8088
KAKAO_REST_API_KEY=
VWORLD_SERVICE_URL=http://localhost
VWORLD_API_KEY=
NEIS_API_KEY=

# Remote CLI: account Personal Access Token (not sb_secret_...) and project DB password.
# Load .env into the command environment; see docs/development.md.
# Pass SUPABASE_PROJECT_REF's value to `supabase link --project-ref` explicitly.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# PR 8: explicit remote execution gate. Keep false until separately approved cutover.
# In Actions use repository variable INGEST_REMOTE_ENABLED and environment ingest-production.
# Remote DB URL must match SUPABASE_PROJECT_REF, use TLS and direct/session-pooler connection.
INGEST_REMOTE_ENABLED=false
# Webhook GitHub token belongs in Supabase Vault (gilmok_github_dispatch_token), not a public env.
